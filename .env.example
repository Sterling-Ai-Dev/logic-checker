# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Exact Claude model ID, e.g. claude-opus-5 — this app will refuse to start
# without it (see server/config.ts). Do not guess an ID; check current
# available models in the Anthropic Console or docs.
ANTHROPIC_MODEL=

# Port the Express server listens on for both /api and (after `npm run build`)
# the built frontend. If you change this, also update the proxy target in
# vite.config.ts.
PORT=3001
